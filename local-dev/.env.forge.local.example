# Copy to local-dev/.env.forge.local (gitignored) before running start-forge-local.*
#
# REQUIRED for local mode — without this, npm run dev uses production backends.
LOCAL_SKIA_BACKEND_URL=http://localhost:3000

SKIA_PORT=4173

# Optional overrides (defaults also in forge.local.config.example.json)
# LOCAL_SKIA_SERVE_URL=http://localhost:11500
# LOCAL_EMBEDDING_ENGINE_URL=http://localhost:5003
# LOCAL_FORGE_URL=http://localhost:4173
# LOCAL_CHAT_PIPELINE_URL=http://localhost:3000/api/skia/chat

SKIA_OWNER_EMAIL=dany.francis@consultant.com
LOCAL_FOUNDER_OVERRIDE=true
LOCAL_FORGE_SOVEREIGN_MODE=autonomous

# JWT must match your local SKIA login service (32+ chars)
# JWT_SECRET=
