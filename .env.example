# SKIA-Forge environment template
# Copy to .env and fill with production values.

NODE_ENV=production
PORT=3000

# Public site metadata
SITE_NAME=SKIA FORGE

# API and service endpoints (Northflank/production)
SKIA_FULL_API_URL=https://api.skia.ca
SKIA_BACKEND_URL=https://api.skia.ca
API_BASE_URL=https://your-api-domain.example.com
GITHUB_TOKEN=your_github_pat_token_here

# Optional feature flags
ENABLE_ANALYTICS=false
# Full Security Audit IDE menu (skia-ide Run menu). Default false = dark / no menu item.
# Served to the IDE via GET /api/forge/modules/status → fullSecurityAuditUi (server env only).
FORGE_FULL_SECURITY_AUDIT_UI=false
# Structured agent planner (also accepted as SKIA_STRUCTURED_OUTPUT_ENABLED)
# FORGE_STRUCTURED_PLANNER=false
